{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "电子军师",
  "version": "6.0.0",
  "identifier": "com.shoalrat.dianzi-junshi",
  "build": {
    "beforeBuildCommand": "bun run build:sidecar",
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/dianzi-junshi-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Lifestyle",
    "shortDescription": "读懂 ta，出三个锦囊",
    "longDescription": "本机运行的恋爱聊天军师：扫梗、读语气、看行动，给你稳、撩、奇三条能直接发的回复，并长期记住 ta 的事。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
